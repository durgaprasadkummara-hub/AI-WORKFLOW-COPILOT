{
  "name": "ai-workflow-copilot-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Workflow Copilot backend with workflow orchestration, AI editing, validation, and realtime task updates.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "health-check": "node scripts/health-check.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@prisma/client": "^5.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "openai": "^4.11.0",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^3.0.0",
    "prom-client": "^15.0.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.18",
    "@types/node": "^20.14.2",
    "prisma": "^5.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
